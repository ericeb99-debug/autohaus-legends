{
  "name": "automotive-empire",
  "productName": "Automotive Empire",
  "version": "2.2.4",
  "description": "Automotive Empire - Desktop-App (Electron-Huelle um autodealer-simulator.html)",
  "main": "main.js",
  "author": "Automotive Empire",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:dev": "set AUTOMOTIVE_EMPIRE_DEV=1&& electron . --dev",
    "build": "electron-builder --win",
    "build:dev": "set AUTOMOTIVE_EMPIRE_DEV=1&& electron-builder --win --config electron-builder.dev.json --publish never",
    "reset:game-data": "node scripts/reset-game-data.js",
    "validate:vehicle-images": "node scripts/validate-vehicle-images.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.eric.automotive-empire",
    "productName": "Automotive Empire",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "autodealer-simulator.html",
      "css/**/*",
      "js/**/*",
      "locales/**/*",
      "data/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/logos/automotive-empire-icon.ico",
      "signtoolOptions": {
        "publisherName": "Automotive Empire"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/logos/automotive-empire-icon.icns"
    },
    "linux": {
      "icon": "assets/logos/automotive-empire-icon-512.png"
    },
    "nsis": {
      "artifactName": "AutomotiveEmpireSetup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Automotive Empire",
      "uninstallDisplayName": "Automotive Empire",
      "installerIcon": "assets/logos/automotive-empire-icon.ico",
      "uninstallerIcon": "assets/logos/automotive-empire-icon.ico",
      "installerHeaderIcon": "assets/logos/automotive-empire-icon.ico"
    },
    "portable": {
      "artifactName": "AutomotiveEmpirePortable.exe"
    }
  }
}
