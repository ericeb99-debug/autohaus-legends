{
  "name": "autohaus-legends",
  "productName": "Autohaus Legends",
  "version": "1.1.1",
  "description": "Autohaus Legends - AutoDealer Simulator als Desktop-App (Electron-Huelle um autodealer-simulator.html)",
  "main": "main.js",
  "author": "Autohaus Legends",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "reset:game-data": "node scripts/reset-game-data.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.eric.autohaus-legends",
    "productName": "Autohaus Legends",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ericeb99-debug",
        "repo": "autohaus-legends",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "autodealer-simulator.html",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/logos/app-icon.ico",
      "signtoolOptions": {
        "publisherName": "Autohaus Legends"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "AutohausLegendsSetup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Autohaus Legends",
      "uninstallDisplayName": "Autohaus Legends",
      "installerIcon": "assets/logos/app-icon.ico",
      "uninstallerIcon": "assets/logos/app-icon.ico",
      "installerHeaderIcon": "assets/logos/app-icon.ico"
    },
    "portable": {
      "artifactName": "AutohausLegendsPortable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
