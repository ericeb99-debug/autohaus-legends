{
  "appId": "de.eric.automotive-empire.dev",
  "productName": "Automotive Empire DEV",
  "extraMetadata": {
    "name": "automotive-empire-dev",
    "productName": "Automotive Empire DEV"
  },
  "directories": {
    "output": "dist-dev"
  },
  "afterPack": "scripts/after-pack-dev.js",
  "asar": false,
  "publish": [],
  "files": [
    "main.js",
    "preload.js",
    "autodealer-simulator.html",
    "css/**/*",
    "js/**/*",
    "locales/**/*",
    "data/**/*",
    "assets/**/*"
  ],
  "win": {
    "icon": "assets/logos/automotive-empire-icon.ico",
    "executableName": "AutomotiveEmpireDEV",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "assets/logos/automotive-empire-icon.icns"
  },
  "linux": {
    "icon": "assets/logos/automotive-empire-icon-512.png"
  },
  "nsis": {
    "artifactName": "AutomotiveEmpireDEVSetup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Automotive Empire DEV",
    "uninstallDisplayName": "Automotive Empire DEV",
    "installerIcon": "assets/logos/automotive-empire-icon.ico",
    "uninstallerIcon": "assets/logos/automotive-empire-icon.ico",
    "installerHeaderIcon": "assets/logos/automotive-empire-icon.ico"
  },
  "portable": {
    "artifactName": "AutomotiveEmpireDEVPortable.exe"
  }
}
